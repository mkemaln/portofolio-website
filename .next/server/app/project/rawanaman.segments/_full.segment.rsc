20:[["$","p",null,{"children":"A mobile app that focuses on track and takes care of your plant. This app can also identify the plant that was captured and the disease that might be affected based on the plant’s leaf. The research are focused on identifying tomato disease from its leaf."}],"\n",["$","h2",null,{"id":"my-contribution","children":"My Contribution"}],"\n",["$","ul",null,{"children":["\n",["$","li",null,{"children":"Responsible for making the ML model using python and tensorflow for plant and disease identification."}],"\n",["$","li",null,{"children":"Built the mobile backend system using Dart, Firebase, and Python."}],"\n",["$","li",null,{"children":"Responsible for setting up the VPS that could handle Machine Learning Process. Ensures high availability and security of VPS infrastructure."}],"\n"]}],"\n",["$","h2",null,{"id":"take-a-look","children":"Take a Look"}],"\n",["$","p",null,{"children":["$","img",null,{"src":"/assets/rawanaman.png","alt":""}]}],"\n",["$","h2",null,{"id":"stack","children":"Stack"}],"\n",["$","p",null,{"children":[["$","code",null,{"children":"Flutter"}]," ",["$","code",null,{"children":"PostgreSQL"}]," ",["$","code",null,{"children":"Python"}]]}]]
