20:[["$","p",null,{"children":"SIRW is a website built for an easier administration and information system within the RW environment. It is capable of managing citizen data, social assistance (bansos), and publishing news or announcements."}],"\n",["$","h2",null,{"id":"my-contribution","children":"My Contribution"}],"\n",["$","ul",null,{"children":["\n",["$","li",null,{"children":"Developed the frontend interface using TailwindCSS."}],"\n",["$","li",null,{"children":"Built the backend system using PHP Laravel Framework."}],"\n",["$","li",null,{"children":"Implemented a responsive design to enhance user experience on various devices."}],"\n",["$","li",null,{"children":"Configured the VPS environment with necessary software and dependencies for the web servers."}],"\n",["$","li",null,{"children":"Implementing auto deployment using github workflow to accelerate the development process."}],"\n"]}],"\n",["$","h2",null,{"id":"take-a-look","children":"Take a Look"}],"\n",["$","p",null,{"children":["$","img",null,{"src":"/assets/sirw.png","alt":""}]}],"\n",["$","h2",null,{"id":"stack","children":"Stack"}],"\n",["$","p",null,{"children":[["$","code",null,{"children":"LARAVEL"}]," ",["$","code",null,{"children":"PYTHON"}]]}]]
